{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Do not update kubernetes major/minor releases',
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
      matchPackageNames: [
        '/kubernetes/kubernetes/',
      ],
    },
  ],
}
