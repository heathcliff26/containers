ARG BASE_IMAGE=ghcr.io/heathcliff26/rust-builder:latest

FROM ${BASE_IMAGE}

LABEL   org.opencontainers.image.authors="heathcliff@heathcliff.eu" \
        org.opencontainers.image.description="Builder and CI image for rust ui projects. Can be used to cross-compile." \
        org.opencontainers.image.source="https://github.com/heathcliff26/containers/tree/main/apps/rust-builder" \
        org.opencontainers.image.licenses="Apache-2.0" \
        org.opencontainers.image.title="rust-qt-builder"

# Installing packages and cross-compile toolchains
RUN set -e; \
    apt-get update; \
    apt-get install -y --no-install-recommends --no-install-suggests \
        appstream \
        qt6-base-dev \
        qt6-wayland-dev \
        libfontconfig-dev \
        libxkbcommon-dev; \
    apt-get install -y --no-install-recommends --no-install-suggests \
        qt6-base-dev:arm64 \
        qt6-wayland-dev:arm64 \
        libfontconfig-dev:arm64 \
        libxkbcommon-dev:arm64; \
    apt-get -qy autoremove; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*;

WORKDIR /app
